# ============================================================================
# AMANITA BOT — ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================================================
# TELEGRAM BOT
# ============================================================================
TELEGRAM_BOT_TOKEN=your_token_from_BotFather

# ============================================================================
# BLOCKCHAIN — MAGIC REGISTRY PATTERN
# ============================================================================
# ⚠️ ВАЖНО: Только MAGIC_REGISTRY_CONTRACT_ADDRESS нужен как hardcoded!
# Все остальные контракты (SpiralEngine, ProductRegistry, etc.) 
# загружаются автоматически через registry.functions.get()

MAGIC_REGISTRY_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Web3 Provider
WEB3_PROVIDER_URI=http://localhost:8545
BLOCKCHAIN_PROFILE=localhost

# ============================================================================
# SELLER CREDENTIALS (localhost defaults)
# ============================================================================
# Эти ключи для Hardhat account #0 (НЕ для production!)
SELLER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SELLER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# ============================================================================
# WEBAPP
# ============================================================================
WALLET_APP_URL=https://your-ngrok-url.ngrok.io/

# ============================================================================
# ENVIRONMENT SETTINGS
# ============================================================================
ENVIRONMENT=local
DEPLOYMENT_PROFILE=localhost
APP_ROOT_DIR=app

# ============================================================================
# CATALOG
# ============================================================================
# Load catalog on startup (true/false)
LOAD_CATALOG=true

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ============================================================================
# API SERVER (FastAPI)
# ============================================================================
# Port for Railway deployment (auto-assigned)
PORT=8000

# ============================================================================
# VAULT (только для polygon profile)
# ============================================================================
# Uncomment для production deployment с HashiCorp Vault:
# VAULT_ADDR=https://your-vault-server.com
# VAULT_TOKEN=your_vault_token
# VAULT_PATH=secret/data/amanita

# ============================================================================
# STORAGE (Arweave/IPFS)
# ============================================================================
STORAGE_COMMUNICATION_TYPE=sync

# ============================================================================
# UPLOADS API (Edge → Backend, моки для тестирования arweave-upload)
# ============================================================================
# Секрет для авторизации вызовов Edge Function → Backend (PUT status, POST callback).
# В запросах к моку передавайте тот же секрет: Authorization: Bearer <значение>.
# Без переменной используется fallback mock-edge-to-backend-secret (только для dev).
# Пример для локальной разработки:
# EDGE_TO_BACKEND_SECRET=amanita-edge-backend-secret-111.444.555.888.555.444.111

# ============================================================================
# SUPABASE (облачный проект или локальный)
# ============================================================================
# Project URL из Dashboard → Project Settings → API
# SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key (public) — для вызова Edge Functions из бота
# SUPABASE_ANON_KEY=your_anon_key
# Service role key (secret) — для доступа бэкенда к таблицам (uploads, orders и т.д.)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================================================
# NOTES
# ============================================================================
# 
# MagicRegistry Pattern:
#   - MAGIC_REGISTRY_CONTRACT_ADDRESS: Единственный hardcoded адрес
#   - SpiralEngine, ProductRegistry, etc.: Loaded via registry.get()
#   - ✅ Single source of truth
#   - ✅ Easy contract upgrades
#   - ✅ No address duplication
#
# Deployment Profiles:
#   - localhost: Secrets from .env, local Hardhat node
#   - polygon: Secrets from Vault, Polygon mainnet
#
# Contract Addresses (DO NOT ADD):
#   ❌ SPIRAL_ENGINE_PROXY_ADDRESS=...       # Don't add (via registry)
#   ❌ PRODUCT_REGISTRY_PROXY_ADDRESS=...    # Don't add (via registry)
#   ❌ ORGANIC_COMPONENT_REGISTRY_...        # Don't add (via registry)
#   ❌ SOUL_IDENTITY_CONTRACT_ADDRESS=...    # Don't add (via registry)
#
# For Production:
#   1. Change DEPLOYMENT_PROFILE=polygon
#   2. Set VAULT_ADDR, VAULT_TOKEN, VAULT_PATH
#   3. Update MAGIC_REGISTRY_CONTRACT_ADDRESS (polygon address)
#   4. Remove localhost SELLER_PRIVATE_KEY (will load from Vault)
#
