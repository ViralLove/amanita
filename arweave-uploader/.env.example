# arweave-uploader — пример переменных окружения
# Скопировать в .env и подставить реальные значения. Не коммитить .env с секретами.

# --- Сервер ---
PORT=3000

# --- Arweave (обязательно один из двух) ---
# JWK одной строкой (JSON)
# ARWEAVE_PRIVATE_KEY={"kty":"RSA",...}
# Либо путь к файлу с JWK (для полной проверки publish-flow при USE_REAL_ARWEAVE=true)
ARWEAVE_PRIVATE_KEY_FILE=./arweave-key.json

# --- Publish-flow: реальный Arweave или мок ---
# true — реальная загрузка в Arweave (нужен ARWEAVE_PRIVATE_KEY_FILE); false — мок, без сети
# USE_REAL_ARWEAVE=false

ARWEAVE_PROTOCOL=https
ARWEAVE_HOST=arweave.net
ARWEAVE_PORT=443

# --- Авторизация relay (опционально) ---
# RELAY_AUTH_TOKEN=

# --- Backend (для потока publish: PUT status, POST callback) ---
# При отсутствии — вызовы пропускаются с предупреждением в лог
# BACKEND_URL=https://your-backend.example.com
# UPLOADER_TO_BACKEND_SECRET=your-shared-secret
# Альтернативное имя секрета (совместимость с контрактом Edge):
# EDGE_TO_BACKEND_SECRET=your-shared-secret

# --- JWT для POST /v1/crystalize (валидация upload_token, RS256) ---
# Публичный ключ (PEM) — на uploader (деплой) в UPLOAD_TOKEN_JWT_PUBLIC_KEY. Для локального прогона publish-flow можно задать путь к файлу:
# UPLOAD_TOKEN_JWT_PUBLIC_KEY_FILE=../keys/amanita_111444555888555444111_public.pem
# Либо значение в одну строку с \n:
# UPLOAD_TOKEN_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----"
# Приватный ключ (PEM) — для подписи JWT в publish-flow и smoke; путь в .env (например в bot/ или keys/). Не коммитить.
# UPLOAD_TOKEN_JWT_PRIVATE_KEY_FILE=../bot/keys/amanita_111444555888555444111_private.pem

# --- Режим мока Backend (см. docs/backend-mock-mode.md) ---
# true/1 — не выполнять реальный fetch к Backend; логировать вызовы и симулировать ответы
# BACKEND_USE_MOCK=true
# Симулированный код ответа (только при BACKEND_USE_MOCK): 200 | 404 | 409
# BACKEND_MOCK_PUT_STATUS=200
# BACKEND_MOCK_CALLBACK=200
# Разрешить переопределение по заголовкам запроса (X-Backend-Mock-Put-Status, X-Backend-Mock-Callback)
# BACKEND_MOCK_ALLOW_REQUEST_OVERRIDE=true
# Секрет для заголовка X-Backend-Mock-Secret (учёт override только при совпадении)
# BACKEND_MOCK_TEST_SECRET=test-secret-for-staging

# --- Real smoke (scripts/smoke-deployed.sh, шаг 3) ---
# Включить шаг «реальный crystalize»: SMOKE_REAL=1 и один из ключей ниже.
# На деплое (Railway) в UPLOAD_TOKEN_JWT_PUBLIC_KEY должен быть публичный ключ от этой же пары.
# SMOKE_REAL=1
# Приватный ключ RSA (PEM) для подписи JWT в smoke — не коммитить
# SMOKE_JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----...
# Либо путь к файлу с PEM
# SMOKE_JWT_PRIVATE_KEY_FILE=./smoke-jwt-private.pem
# После 200 smoke проверяет, что tx есть в Arweave (GET по arweave_url). Задержка перед проверкой (мс):
# SMOKE_VERIFY_DELAY_MS=3000
# Явный URL для проверки tx (по умолчанию — arweave_url из ответа):
# SMOKE_VERIFY_ARWEAVE_URL=https://arweave.net/{tx_id}
