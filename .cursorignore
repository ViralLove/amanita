# 🔐 Cursor AI Safety Rules
# Эти файлы НИКОГДА не читаются AI ассистентом

# ============================================================================
# 🔴 КРИТИЧЕСКИЕ КЛЮЧИ
# ============================================================================

# Environment variables (приватные ключи, API токены)
.env
.env.*
!.env.example
!.env.template
ENV_TEMPLATE.txt

# Arweave приватные ключи
.arweave-key.json
arweave-wallet.json
**/arweave-wallet.json
bot/arweave-wallet.json

# Ethereum приватные ключи
wallet/*.json
!wallet/README.md

# ============================================================================
# 📁 SENSITIVE DATA
# ============================================================================

# API keys и токены
api_keys.json
**/api_keys.json

# Логи с потенциально чувствительными данными
*.log
logs/*
special_logs/*

# Кеш с адресами и транзакциями
pinata_cache.json
image_cache/*

# ============================================================================
# 🔒 DEPLOYMENT & PRODUCTION
# ============================================================================

# Production конфигурация
.env.production
config/production.json

# Backup файлы с чувствительными данными
.env.backup*
*.backup

# ============================================================================
# 🧪 TEST DATA
# ============================================================================

# Тестовые ключи (на всякий случай)
.env.test
.env.local

# ============================================================================
# 📊 GENERATED FILES (большие, не нужны AI)
# ============================================================================

# Node modules
node_modules/*
venv/*
bot/venv/*

# Build artifacts
artifacts/*
cache/*
*.pyc
__pycache__/*

# Dependencies
package-lock.json
bot/requirements.txt

# ============================================================================
# 🎨 MEDIA (большие файлы, не нужны для анализа кода)
# ============================================================================

# Images
*.jpeg
*.jpg
*.png
*.gif
*.webp

# Videos
*.mp4
*.avi

# Archives
*.zip
*.tar.gz

# ============================================================================
# 🗂️ LARGE DATA
# ============================================================================

# WordPress plugin (огромный размер, не нужен)
wp_plugin/*

# ============================================================================
# ⚙️ SYSTEM FILES
# ============================================================================

.DS_Store
*.swp
*.swo
*~

# ============================================================================
# 📝 NOTES
# ============================================================================
#
# Как это работает:
# 1. .gitignore — защищает от Git (commit/push)
# 2. .cursorignore — защищает от AI (codebase_search, grep, auto-context)
# 3. Оба нужны для полной безопасности!
#
# Cursor НЕ читает файлы из .cursorignore даже если:
# - Файл открыт в редакторе
# - Используется codebase_search
# - Используется grep
# - Файл в workspace
#
# ИСКЛЮЧЕНИЕ: Если явно вызвать read_file с абсолютным путём
# Решение: Просто не вызывать read_file на приватные файлы
#
# ============================================================================

