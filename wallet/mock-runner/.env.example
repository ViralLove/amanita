# =============================================================================
# Wallet-mock runner — пример переменных окружения
# =============================================================================
# Скопируйте в .env и подставьте значения:
#   cp .env.example .env
# При npm start файл .env подгружается автоматически (dotenv).
# Не коммитить .env с реальными секретами (ключи EVM, JWK, токены).
#
# Полный перечень переменных, которые читает index.js: см. README.md и
# wallet/docs/analysis/wallet-mock-env-and-identity-audit-2026-04-02.md
# =============================================================================

# --- POC Identity SSOT (WAL-POC-1) ---
# Одно и то же значение на всём пути: USER_ID здесь; X-User-Id при draft;
# user_id в GET /v1/pending-sign-requests?user_id=...
USER_ID=111.444.555.888.555.444.111

# --- Bot API (для удалённых хостов всегда указывайте схему https://) ---
BOT_URL=https://amanita-node-888.up.railway.app
POLL_INTERVAL_MS=2000

# Опционально: базовый URL arweave-uploader; если не задан — берётся из
# ответа GET .../sign-payload (поле arweave_uploader_url).
ARWEAVE_SERVICE_URL=https://amanita-uploader-888.up.railway.app

# --- Wallet auth (бот: challenge → verify → Bearer) ---
WALLET_AUTH_MODE=challenge_signature
WALLET_ALLOW_LEGACY_X_USER_ID=true
# WALLET_AUTH_SCOPE=signing_flow

# EVM private key (hex) для подписи challenge и для real sign_contract.
# Без ключа — fallback по политике бота; real submit будет пропущен.
WALLET_MOCK_PRIVATE_KEY=0x...
# Явный адрес (редко нужен, если задан WALLET_MOCK_PRIVATE_KEY):
WALLET_MOCK_ADDRESS=0x...

# --- sign_arweave → POST {uploader}/v1/crystalize ---
# Режимы: local-valid (дефолт), dummy, poc-jwk (алиас env-jwk).
# WALLET_MOCK_ARWEAVE_SIGN_MODE=local-valid
# Каталог arweave-uploader (фикстура local-valid + deep-hash для poc-jwk).
# ARWEAVE_UPLOADER_PATH=/abs/path/to/arweave-uploader

# --- Arweave JWK (WAL-POC-7): свой ключ; приоритет env > file как в arweave-uploader ---
# JWK должен быть RSA-2048 (совместимость с validateDataItem на uploader).
# WALLET_MOCK_ARWEAVE_SIGN_MODE=poc-jwk
# WALLET_MOCK_ARWEAVE_PRIVATE_KEY={"kty":"RSA",...}
# WALLET_MOCK_ARWEAVE_PRIVATE_KEY_FILE=./arweave-key-2048.json

# --- sign_contract → POST /v1/sign-requests/{id}/submit (EVM) ---
# JSON-RPC той же сети, что chain_id у бота / sign-request.
# WALLET_MOCK_RPC_URL=http://127.0.0.1:8545
# real (дефолт) — подпись createActivity; dummy — заглушка 0x00… (отладка).
# WALLET_MOCK_SIGN_CONTRACT_MODE=real
# 0 = Event, 1 = Service (IActivityRegistry.ActivityType).
# WALLET_MOCK_ACTIVITY_TYPE=0

# --- Оркестратор bullrun (scripts/shell/run-bullrun-floou.sh) ---
# Если скрипт задаёт путь — runner пишет JSON после успешного submit.
# FLOOU_DONE_MARKER_FILE=/tmp/floou-done-marker.json
